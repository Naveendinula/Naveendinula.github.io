  "numeric_patterns": {
    "ach50_regex": "\\b(?:ACH\\s*50|ACH50)\\s*[:=]?\\s*(\\d+(?:\\.\\d+)?)\\b",
    "rval_regex": "\\bR[-\\s]?(\\d+(?:\\.\\d+)?)\\b",
    "tons_regex": "\\b(\\d+(?:\\.\\d+)?)\\s*(?:ton|tons)\\b",
    "amps_regex": "\\b(\\d{2,4})\\s*amp(?:s)?\\b",
    "seer_regex": "\\bSEER\\s*(\\d+(?:\\.\\d+)?)\\b",
    "seer2_regex": "\\bSEER2\\s*[:=]?\\s*(\\d+(?:\\.\\d+)?)\\b",
    "eer_regex": "\\bI?EER\\s*[:=]?\\s*(\\d+(?:\\.\\d+)?)\\b",
    "hspf_regex": "\\bHSPF2?\\s*[:=]?\\s*(\\d+(?:\\.\\d+)?)\\b",
    "cop_regex": "\\bCOP\\s*[:=]?\\s*(\\d+(?:\\.\\d+)?)\\b",
    "kw_regex": "\\b(\\d+(?:\\.\\d+)?)\\s*kW\\b",
    "mbh_regex": "\\b(\\d{2,4})\\s*MBH\\b",
    "cfm_regex": "\\b(\\d{2,5})\\s*CFM(?:\\s*25|\\s*50)?\\b",
    "u_factor_regex": "\\bU[-\\s]?(?:factor|value)\\s*[:=]?\\s*(\\d+(?:\\.\\d+)?)\\b",
    "shgc_regex": "\\bSHGC\\s*[:=]?\\s*(\\d+(?:\\.\\d+)?)\\b",
    "uef_regex": "\\bUEF\\s*[:=]?\\s*(\\d+(?:\\.\\d+)?)\\b",
    "seer_or_ieer_note": "Keep both EER/IEER because commercial permits often cite IEER for RTUs/chillers."
  },
